  <version>0.0.1-SNAPSHOT</version>
  <name>esgf-dashboard-ui</name>
  
  <dependencies>
  
    <dependency>
	    <groupId>org.junit.jupiter</groupId>
	    <artifactId>junit-jupiter-api</artifactId>
	    <version>5.10.2</version>
	    <scope>test</scope>
	</dependency>
    
    <dependency>
